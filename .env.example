# URL de conexão do PostgreSQL usada pelo backend.
# Substitua apenas em um arquivo .env local; não versionar credenciais reais.
DATABASE_URL=postgresql+psycopg://crm_user:crm_password@localhost:5432/crm_geral

# URL de um banco PostgreSQL dedicado exclusivamente aos testes de persistência.
# Use credenciais locais de teste; não reutilize um banco de produção.
TEST_DATABASE_URL=postgresql+psycopg://crm_user:crm_password@localhost:5432/crm_geral_test
